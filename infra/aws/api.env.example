NODE_ENV=production
HOST=127.0.0.1
PORT=3002
CLIENT_ORIGIN=https://REPLACE_WITH_AMPLIFY_DOMAIN
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_RDS_HOST:5432/socasas?schema=public&sslmode=require&sslaccept=strict&sslcert=/etc/socasas/rds-ca.pem
COGNITO_USER_POOL_ID=REPLACE_FROM_STACK
COGNITO_CLIENT_ID=REPLACE_FROM_STACK
AWS_REGION=REPLACE_WITH_SELECTED_REGION
S3_BUCKET_NAME=REPLACE_FROM_STACK
S3_PUBLIC_BASE_URL=https://REPLACE_CLOUDFRONT_DOMAIN
# Use the EC2 instance profile. No AWS access keys belong in this file.
